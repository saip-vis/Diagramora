# Copy this file to .env and fill in the blanks. Never commit .env.
OPENAI_API_KEY=
FLASK_SECRET_KEY=
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
# Keep blank unless a future backend-only feature explicitly requires it.
SUPABASE_SECRET_KEY=
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:5000
# Low-latency model used for focused natural-language editor changes.
AI_EDIT_MODEL=gpt-4.1-nano
# Total authenticated AI-backed API calls allowed per account per day.
DAILY_AI_LIMIT=200
